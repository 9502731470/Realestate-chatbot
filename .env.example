# Copy this template to .env and provide your own credentials locally.
# This file contains defaults only; never put real credentials in this template.
OPENROUTER_API_KEY=

# ADMIN_TOKEN=choose-a-private-admin-token
# PUBLIC_URL=https://your-app.onrender.com

HOST=0.0.0.0
PORT=7860
LOG_LEVEL=INFO
DATA_DIR=data
MODEL_CACHE_DIR=models

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
ENABLE_DENSE=true
VECTOR_BACKEND=chroma
EMBEDDING_BATCH_SIZE=16

SOURCES=darglobal,wasalt
TLS_TRUST=auto
CRAWL_MIN_INTERVAL_S=1.0
CRAWL_TIMEOUT_S=30.0
INGEST_ON_STARTUP=if-missing
REFRESH_INTERVAL_HOURS=24
